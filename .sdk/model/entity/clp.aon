# Entity: clp

main: kit: entity: clp: {

  alias: field: {}

  fields: [
    {
      name: "casa"
      req: true
      type: "`$STRING`"
    }
    {
      name: "compra"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "fechaActualizacion"
      req: true
      type: "`$STRING`"
    }
    {
      name: "moneda"
      req: true
      type: "`$STRING`"
    }
    {
      name: "nombre"
      req: true
      type: "`$STRING`"
    }
    {
      name: "venta"
      req: true
      type: "`$NUMBER`"
    }
  ]

  name: "clp"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/v1/cotizaciones/clp"
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "cotizaciones"
            }
            {
              lit: "clp"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
